# Generated by hand to mirror the Python public surface.
# Public functions use lowercase/dotted alpha names; internal helpers are
# prefixed with a dot (".helper") so they are NOT exported by this pattern.
exportPattern("^[[:alpha:]]")
export("%||%")
export(.cfg_get)

